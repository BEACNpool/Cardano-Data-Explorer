# Cardano Data Explorer - environment template

# Snapshot source Postgres (sync source)
SOURCE_PGHOST=127.0.0.1
SOURCE_PGPORT=5432
SOURCE_PGUSER=postgres
SOURCE_PGDATABASE=cexplorer

# Warehouse Postgres
WAREHOUSE_PGHOST=127.0.0.1
WAREHOUSE_PGPORT=5433
WAREHOUSE_PGUSER=postgres
WAREHOUSE_PGDATABASE=cardano_raw

# Canonical storage root
CARDANO_INTEL_ROOT=/data/cardano-intel
CARDANO_INTEL_INCOMING=/data/cardano-intel/incoming
CARDANO_INTEL_ARCHIVE=/data/cardano-intel/archive
CARDANO_INTEL_STATE=/data/cardano-intel/state
CARDANO_INTEL_LOGS=/data/cardano-intel/logs
CARDANO_INTEL_EXPORTS=/data/cardano-intel/exports

# Active snapshot marker
ACTIVE_SNAPSHOT_PATH=/data/cardano-intel/state/active_snapshot.json

# Snapshot cadence recommendation (docs default)
SNAPSHOT_CADENCE=daily+on-demand
